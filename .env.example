# Smart Reading Device — Cloud & Hardware Configuration
# Copy this file to .env on the Raspberry Pi:
#   cp .env.example .env

# URL of the NestJS Backend (use your VPS domain or laptop IP on the same Wi-Fi/Hotspot)
BACKEND_HTTP_URL=http://localhost:3001
BACKEND_WS_URL=ws://localhost:3001/ws

